<Window x:Class="WinTAKTracker.Views.CallsignSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set your callsign"
        Height="360" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
               Text="Welcome. Set a callsign for this Windows user. While you are logged in, CoT PLI uses your identity. After logoff, the computer callsign is used instead."/>
    <TextBlock Grid.Row="1" Text="My callsign" FontWeight="SemiBold"/>
    <TextBox x:Name="CallsignBox" Grid.Row="2" Margin="0,4,0,10"/>
    <TextBlock Grid.Row="3" Text="Team"/>
    <ComboBox x:Name="TeamBox" Grid.Row="4" IsEditable="True" Margin="0,4,0,10"/>
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Use computer callsign for now" Margin="0,0,8,0" Padding="12,6" Click="Skip_OnClick"/>
      <Button Content="Save" Padding="16,6" IsDefault="True" Click="Save_OnClick"/>
    </StackPanel>
  </Grid>
</Window>
