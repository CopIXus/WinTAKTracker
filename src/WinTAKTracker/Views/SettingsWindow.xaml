<Window x:Class="WinTAKTracker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource AppWindow}"
        Title="WinTAKTracker Settings"
        Height="600" Width="880"
        MinHeight="440" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/WinTAKTrackerLogo.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,24">
                    <TextBlock Text="WinTAKTracker"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource SidebarTextBrush}"/>
                    <TextBlock Text="Settings"
                               FontSize="12"
                               Foreground="{DynamicResource SidebarMutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <ListBox x:Name="SectionList"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource SidebarTextBrush}"
                         Padding="12,0"
                         ItemContainerStyle="{DynamicResource SidebarNavItem}"
                         SelectionChanged="SectionList_OnSelectionChanged">
                    <ListBoxItem Content="Status" Tag="Status"/>
                    <ListBoxItem Content="Servers" Tag="Servers"/>
                    <ListBoxItem Content="Identity" Tag="Identity"/>
                    <ListBoxItem Content="GPS" Tag="Gps"/>
                    <ListBoxItem Content="Reporting" Tag="Reporting"/>
                    <ListBoxItem Content="Mesh SA" Tag="MeshSa"/>
                    <ListBoxItem Content="View the map" Tag="ViewMap"/>
                    <ListBoxItem Content="Startup" Tag="Startup"/>
                    <ListBoxItem Content="Diagnostics" Tag="Diagnostics"/>
                    <ListBoxItem Content="Updates" Tag="Updates"/>
                    <ListBoxItem Content="About" Tag="About"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="SectionTitle"
                       Grid.Row="0"
                       Text="Status"
                       Style="{DynamicResource SectionTitleText}"/>

            <Border Grid.Row="1" Style="{DynamicResource ContentSurface}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0">
                    <StackPanel x:Name="SectionContent"/>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,16,0,0"
                    Padding="0,12,0,0"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <Button x:Name="PauseResumeButton"
                            Style="{DynamicResource SecondaryButton}"
                            Content="Pause tracking"
                            Margin="0,0,8,0"
                            Click="PauseResumeButton_OnClick"/>
                    <Button x:Name="LockSettingsButton"
                            Style="{DynamicResource SecondaryButton}"
                            Content="Unlock…"
                            Margin="0,0,12,0"
                            Click="LockSettingsButton_OnClick"/>
                    <TextBlock x:Name="LockStatusText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"/>
                    <Button Content="Close"
                            Style="{DynamicResource SecondaryButton}"
                            Padding="18,7"
                            DockPanel.Dock="Right"
                            IsCancel="True"
                            Click="CloseButton_OnClick"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
