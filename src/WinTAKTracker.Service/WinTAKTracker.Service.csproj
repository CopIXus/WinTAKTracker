<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinTAKTracker.Service</RootNamespace>
    <AssemblyName>WinTAKTracker.Service</AssemblyName>
    <Product>WinTAKTracker</Product>
    <Company>CopIX LLC</Company>
    <Authors>CopIX LLC</Authors>
    <Copyright>Copyright © CopIX LLC</Copyright>
    <Description>Windows Service host for always-on WinTAKTracker PLI.</Description>
    <Version>0.1.0</Version>
    <OutputType>Exe</OutputType>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinTAKTracker.Core\WinTAKTracker.Core.csproj" />
  </ItemGroup>

</Project>
