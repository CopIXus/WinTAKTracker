<Window x:Class="WinTAKTracker.Views.CallsignSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource AppWindow}"
        Title="Set your callsign"
        Height="380" Width="440"
        MinHeight="320" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/WinTAKTrackerLogo.ico">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0"
               Style="{DynamicResource BlurbText}"
               Margin="0,0,0,8"
               Text="Welcome. Set a callsign for this Windows user. While you are logged in, CoT PLI uses your identity. After logoff, the computer callsign is used instead."/>
    <TextBlock Grid.Row="1" Text="My callsign" Style="{DynamicResource FieldLabelText}" Margin="0,0,0,6"/>
    <TextBox x:Name="CallsignBox" Grid.Row="2" Margin="0,0,0,4"/>
    <TextBlock Grid.Row="3" Text="Team" Style="{DynamicResource FieldLabelText}" Margin="0,8,0,6"/>
    <ComboBox x:Name="TeamBox" Grid.Row="4" IsEditable="True" Margin="0,0,0,10"/>
    <TextBlock x:Name="ErrorText"
               Grid.Row="5"
               Style="{DynamicResource HelperText}"
               Foreground="{DynamicResource DangerBrush}"
               VerticalAlignment="Top"/>
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Use computer callsign for now"
              Style="{DynamicResource SecondaryButton}"
              Margin="0,0,8,0"
              Click="Skip_OnClick"/>
      <Button Content="Save"
              Style="{DynamicResource PrimaryButton}"
              MinWidth="88"
              IsDefault="True"
              Click="Save_OnClick"/>
    </StackPanel>
  </Grid>
</Window>
