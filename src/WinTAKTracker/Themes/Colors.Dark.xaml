<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Dark — branded sidebar, dark content surfaces, no purple/glow -->
    <Color x:Key="SidebarBgColor">#0E1A14</Color>
    <Color x:Key="SidebarHoverColor">#1A2E24</Color>
    <Color x:Key="SidebarSelectedColor">#2A4A38</Color>
    <Color x:Key="SidebarTextColor">#E8F0EA</Color>
    <Color x:Key="SidebarMutedColor">#8AA896</Color>
    <Color x:Key="AccentColor">#3D8F68</Color>
    <Color x:Key="AccentHoverColor">#4AA178</Color>
    <Color x:Key="AccentPressedColor">#2F6B4F</Color>
    <Color x:Key="ContentBgColor">#121816</Color>
    <Color x:Key="SurfaceColor">#1C2420</Color>
    <Color x:Key="SurfaceSubtleColor">#252E2A</Color>
    <Color x:Key="BorderColor">#2E3A34</Color>
    <Color x:Key="BorderStrongColor">#44554C</Color>
    <Color x:Key="FocusBorderColor">#3D8F68</Color>
    <Color x:Key="TextPrimaryColor">#E8EEEA</Color>
    <Color x:Key="TextSecondaryColor">#A8B8B0</Color>
    <Color x:Key="TextMutedColor">#7A8A82</Color>
    <Color x:Key="DangerColor">#EF9A9A</Color>
    <Color x:Key="DangerBgColor">#3A2222</Color>
    <Color x:Key="InfoBgColor">#1E2E26</Color>
    <Color x:Key="DisabledBgColor">#1A201C</Color>
    <Color x:Key="DisabledFgColor">#6A7670</Color>
    <Color x:Key="StatusOkBgColor">#1B3D28</Color>
    <Color x:Key="StatusOkFgColor">#A5D6A7</Color>
    <Color x:Key="StatusInfoBgColor">#1A2A3A</Color>
    <Color x:Key="StatusInfoFgColor">#90CAF9</Color>
    <Color x:Key="StatusWarnBgColor">#3A2A18</Color>
    <Color x:Key="StatusWarnFgColor">#FFCC80</Color>
    <Color x:Key="StatusNeutralBgColor">#2A322E</Color>
    <Color x:Key="StatusNeutralFgColor">#C0C8C4</Color>
    <Color x:Key="ScrollBarTrackColor">#161C19</Color>
    <Color x:Key="ScrollBarThumbColor">#4A5A52</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#6A7A72</Color>

    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}"/>
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource SidebarSelectedColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="{StaticResource SidebarMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="ContentBgBrush" Color="{StaticResource ContentBgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource SurfaceSubtleColor}"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="{StaticResource FocusBorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource InfoBgColor}"/>
    <SolidColorBrush x:Key="DisabledBgBrush" Color="{StaticResource DisabledBgColor}"/>
    <SolidColorBrush x:Key="DisabledFgBrush" Color="{StaticResource DisabledFgColor}"/>
    <SolidColorBrush x:Key="StatusOkBgBrush" Color="{StaticResource StatusOkBgColor}"/>
    <SolidColorBrush x:Key="StatusOkFgBrush" Color="{StaticResource StatusOkFgColor}"/>
    <SolidColorBrush x:Key="StatusInfoBgBrush" Color="{StaticResource StatusInfoBgColor}"/>
    <SolidColorBrush x:Key="StatusInfoFgBrush" Color="{StaticResource StatusInfoFgColor}"/>
    <SolidColorBrush x:Key="StatusWarnBgBrush" Color="{StaticResource StatusWarnBgColor}"/>
    <SolidColorBrush x:Key="StatusWarnFgBrush" Color="{StaticResource StatusWarnFgColor}"/>
    <SolidColorBrush x:Key="StatusNeutralBgBrush" Color="{StaticResource StatusNeutralBgColor}"/>
    <SolidColorBrush x:Key="StatusNeutralFgBrush" Color="{StaticResource StatusNeutralFgColor}"/>
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{StaticResource ScrollBarTrackColor}"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource ScrollBarThumbHoverColor}"/>

    <sys:Double x:Key="FontSizeBody">13</sys:Double>
</ResourceDictionary>
