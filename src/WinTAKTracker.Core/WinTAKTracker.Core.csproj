<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinTAKTracker</RootNamespace>
    <AssemblyName>WinTAKTracker.Core</AssemblyName>
    <Product>WinTAKTracker</Product>
    <Company>CopIX LLC</Company>
    <Authors>CopIX LLC</Authors>
    <Copyright>Copyright © CopIX LLC</Copyright>
    <Description>Headless tracking core for WinTAKTracker (GPS, CoT, TAK, Mesh, config).</Description>
    <Version>0.1.0</Version>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

</Project>
