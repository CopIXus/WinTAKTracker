<Window x:Class="WinTAKTracker.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource AppWindow}"
        Title="Password"
        Height="240" Width="420"
        MinHeight="200" MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText"
                   Grid.Row="0"
                   Style="{DynamicResource BlurbText}"
                   Margin="0,0,0,8"/>

        <TextBlock x:Name="PrimaryLabel"
                   Grid.Row="1"
                   Text="Password"
                   Style="{DynamicResource FieldLabelText}"
                   Margin="0,0,0,6"/>
        <PasswordBox x:Name="PrimaryBox"
                     Grid.Row="2"
                     Margin="0,0,0,8"/>

        <StackPanel x:Name="ConfirmPanel" Grid.Row="3" Visibility="Collapsed">
            <TextBlock Text="Confirm password"
                       Style="{DynamicResource FieldLabelText}"
                       Margin="0,0,0,6"/>
            <PasswordBox x:Name="ConfirmBox"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="4"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}"
                   VerticalAlignment="Top"
                   FontSize="12"
                   Margin="0,8,0,8"/>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Style="{DynamicResource SecondaryButton}"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_OnClick"/>
            <Button Content="OK"
                    Style="{DynamicResource PrimaryButton}"
                    MinWidth="88"
                    IsDefault="True"
                    Click="Ok_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
